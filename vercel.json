{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/simulador", "statusCode": 307 }
  ],
  "rewrites": [
    { "source": "/simulador/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/simulador", "destination": "/index.html" },
    { "source": "/simulador/:path*", "destination": "/index.html" }
  ]
}
